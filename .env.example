NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Render Postgres internal connection string
DATABASE_URL=postgres://user:password@host:5432/database

# Shared Render Environment Group values
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Comma-separated school administrator email addresses.
# Replace with the school-owned admin mailbox before production.
ADMIN_EMAILS=tech@westlandhigh.school.nz

# Optional: restrict login to school Google Workspace domain.
# Leave blank to allow any Google account while testing.
GOOGLE_HOSTED_DOMAIN=
