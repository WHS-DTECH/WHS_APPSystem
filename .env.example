NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Render Postgres internal connection string
DATABASE_URL=postgres://user:password@host:5432/database

# Optional read-only legacy database connections. Keep these in the Render
# LegacyDatabases environment group and use them for controlled imports.
INTEGRATION_SEWING_HUB_DATABASE_URL=postgres://user:password@host:5432/sewing_hub
INTEGRATION_WORKSHOP_DATABASE_URL=postgres://user:password@host:5432/workshop
INTEGRATION_FOOD_ROOM_DATABASE_URL=postgres://user:password@host:5432/food_room

# Legacy WHS_LearningSite database (HOD Update Dashboard data). Copied once into DATABASE_URL.
# INTEGRATION_LEARNING_SITES_DATABASE_URL=

# Sewing Hub image uploads (copy from the old Sewing service): set Cloudinary or Object Storage vars.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=sewing-room-activities
# Legacy Kamar Uploader database (Term 1-3 data). Copied once into DATABASE_URL.
# Falls back to INTEGRATION_LEARNING_SITES_DATABASE_URL when unset.
# INTEGRATION_KAMAR_DATABASE_URL=

# Shared Render Environment Group values
# Use SESSION_SECRET for new deployments. SECRET_KEY is also supported for the existing Render environment group.
SESSION_SECRET=replace-with-a-long-random-secret
# SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional Google Gmail API foundation for notifications and teacher/admin email alerts.
# Set these values if you want the app to send email using a Gmail OAuth2 account.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_GMAIL_SENDER_EMAIL=
GOOGLE_GMAIL_TO=admin@westlandhigh.school.nz,tech@westlandhigh.school.nz

# Comma-separated school administrator email addresses.
# Replace with the school-owned admin mailbox before production.
ADMIN_EMAILS=vanessapringle@westlandhigh.school.nz,tech@westlandhigh.school.nz

# Optional: restrict login to school Google Workspace domain.
# Leave blank to allow any Google account while testing.
GOOGLE_HOSTED_DOMAIN=

# Workshop suggestion emails use the GOOGLE_GMAIL_* settings above. SITE_URL is used in email links.
# SITE_URL=https://whs-appsystem.onrender.com

# Food Room legacy settings (see README). Emails use the GOOGLE_GMAIL_* settings above.
# PLACE_ORDER_PILOT_RECIPIENT=
# PLACE_ORDER_ADMIN_COPY_RECIPIENTS=
# PLACE_ORDER_TUESDAY_CRON=0 9 * * 2
# WEEKLY_DIGEST_CRON=0 19 * * 0
# SUGGESTION_NOTIFY_TO=
# GOOGLE_CREDENTIALS=
# GOOGLE_TOKEN_JSON=
# GOOGLE_OAUTH_REDIRECT_URI=https://your-site/food-room/google/oauth2callback
# GOOGLE_PLANNER_DOC_IDS=

# Student Apps private GitHub archive. IDs are not secrets; keys belong in Render Secret Files.
# Upload each PEM as a secret file on the main WHS APPSystem service, never to Git.
GITHUB_ARCHIVE_REPOSITORY=WHS-DTECH/WHS-TECHArchive
GITHUB_READER_APP_ID=
GITHUB_READER_PRIVATE_KEY_FILE=/etc/secrets/github-reader.pem
GITHUB_WRITER_APP_ID=
GITHUB_WRITER_PRIVATE_KEY_FILE=/etc/secrets/github-writer.pem
