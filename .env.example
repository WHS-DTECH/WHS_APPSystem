NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Render Postgres internal connection string
DATABASE_URL=postgres://user:password@host:5432/database

# Shared Render Environment Group values
# Use SESSION_SECRET for new deployments. SECRET_KEY is also supported for the existing Render environment group.
SESSION_SECRET=replace-with-a-long-random-secret
# SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional Google Gmail API foundation for notifications and teacher/admin email alerts.
# Set these values if you want the app to send email using a Gmail OAuth2 account.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_GMAIL_SENDER_EMAIL=
GOOGLE_GMAIL_TO=admin@westlandhigh.school.nz,tech@westlandhigh.school.nz

# Comma-separated school administrator email addresses.
# Replace with the school-owned admin mailbox before production.
ADMIN_EMAILS=vanessapringle@westlandhigh.school.nz,tech@westlandhigh.school.nz

# Optional: restrict login to school Google Workspace domain.
# Leave blank to allow any Google account while testing.
GOOGLE_HOSTED_DOMAIN=
