DATABASE_URL=
DATABASE_SSL=true
SESSION_SECRET=
# Shared non-secret setting: link a module-safe Render Environment Group.
GLOBAL_CONTROL_URL=https://whs-appsystem.onrender.com
# Site-specific setting:
MODULE_CLIENT_ID=whs-assessment-manager:development
# Optional on Render: defaults to RENDER_EXTERNAL_URL.
APP_BASE_URL=
MODULE_ENVIRONMENT=development
# Optional Google Picker configuration for moderation document workflows.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_APP_ID=
PORT=3000
