<%- include('../partials/header') %>

<section class="page-title">
  <p class="eyebrow">Administration</p>
  <h1>App Module Management</h1>
</section>

<section class="panel">
  <form class="module-form" action="/admin/modules" method="post">
    <label>Module key<input name="moduleKey" placeholder="attendance" required></label>
    <label>Display name<input name="displayName" placeholder="Attendance" required></label>
    <label>Description<input name="description" placeholder="Attendance tracking and reports"></label>
    <label>Path<input name="path" placeholder="/modules/attendance"></label>
    <label class="inline"><input name="isActive" type="checkbox" checked> Active</label>
    <button class="button button-primary" type="submit">Save module</button>
  </form>
</section>

<section class="panel table-panel">
  <% modules.forEach((module) => { const doc = moduleDocs[module.module_key]; %>
    <article class="module-row">
      <div>
        <strong><%= module.display_name %></strong>
        <span><%= module.module_key %> · <%= module.path %></span>
      </div>
      <span class="status"><%= module.is_active ? 'Active' : 'Inactive' %></span>
    </article>
    <% if (doc) { %>
      <details class="module-doc">
        <summary>Setup details: environment variables and database</summary>
        <p><%= doc.summary %></p>
        <p><strong>Legacy database:</strong> <%= doc.legacyDatabase.used ? 'Yes' : 'No' %>. <%= doc.legacyDatabase.how %></p>
        <% if (doc.env.length) { %>
          <table class="module-doc-table">
            <thead><tr><th>Environment variable</th><th>Needed</th><th>Status</th><th>Purpose</th></tr></thead>
            <tbody>
              <% doc.env.forEach((item) => { %>
                <tr>
                  <td><code><%= item.name %></code><%= item.legacy ? ' (legacy database)' : '' %></td>
                  <td><%= item.optional ? 'Optional' : 'Required' %></td>
                  <td class="<%= item.isSet ? 'env-set' : (item.optional ? 'env-unset' : 'env-missing') %>"><%= item.isSet ? 'Set' : 'Not set' %></td>
                  <td><%= item.note %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <p>No environment variables of its own.</p>
        <% } %>
      </details>
    <% } %>
  <% }) %>
</section>

<%- include('../partials/footer') %>
