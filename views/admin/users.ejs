<%- include('../partials/header') %>

<section class="page-title">
  <p class="eyebrow">Administration</p>
  <h1>Assign User Roles</h1>
  <p>Choose Global Control or any registered module to view its existing role and access controls.</p>
</section>

<section class="panel">
  <form action="/admin/users" method="get">
    <label for="role-module">Module</label>
    <select id="role-module" name="module">
      <option value="global" <%= module === 'global' ? 'selected' : '' %>>Global Control (system-wide)</option>
      <% modules.forEach((item) => { %>
        <option value="<%= item.key %>" <%= module === item.key ? 'selected' : '' %>><%= item.label %></option>
      <% }) %>
    </select>
    <button class="button" type="submit">Show module roles</button>
  </form>
  <p>Managing: <strong><%= moduleLabel %></strong>. Role choices and the list below apply only to this selection.</p>
  <p><strong>Global ADMIN has administration across all hubs.</strong> A lower hub role does not restrict a Global ADMIN.
    Within a hub, Lead Teacher is its administrator role. Global Control Lead Teacher has Teacher access only.</p>
  <p>All registered modules, registered apps and Module Builder projects are included. Area-specific grants remain in their existing management pages.</p>
  <% if (module === 'teacher-planner') { %>
    <p>Assign <strong>Teacher</strong> below to enable Teacher Planner sign-in. This is separate from Global Control Teacher.
      Each teacher can access only their own planner entries. School-wide settings remain Global-ADMIN-only.
      Removing the assignment revokes access on the next identity check. This assignment applies to the registered Teacher Planner environments.</p>
  <% } %>
  <% if (!editable) { %>
    <h2>Existing access controls — <%= moduleLabel %></h2>
    <% if (selectedModule.project_id) { %>
      <p>This is a Module Builder project, not an independently assignable hub role. The current Global Control module sign-in bridge requires Global ADMIN and rechecks that role on every identity request. Assigning Teacher or a teacher module allocation will not bypass that restriction. Do not grant ADMIN just to provide module access.</p>
      <a class="button" href="/module-builder/<%= selectedModule.project_id %>">View project and environment access settings</a>
    <% } else { %>
      <p>This module has no independent module roles registered. Its existing route permissions and Global Control roles still apply. A teacher module assignment controls its appearance on the Teacher dashboard; it does not override sign-in, administrator-only routes or other module restrictions.</p>
      <a class="button" href="/admin/teachers">Manage existing teacher module assignments</a>
      <a class="button" href="/admin/roles">View existing role permissions</a>
      <% if (selectedModule.kind === 'app') { %><a class="button" href="/student-apps">Manage registered app access and role mapping</a><% } %>
    <% } %>
    <a class="button" href="/admin/users?module=global">Manage Global Control roles</a>
    <% if (!selectedModule.active) { %><p><strong>This module is inactive or archived. Listing it here does not enable it.</strong></p><% } %>
  <% } %>
</section>
<% if (saved) { %>
  <p class="panel" role="status"><%= moduleLabel %> role <%= saved %>. Other role assignments are unchanged.</p>
<% } %>
<% if (editable) { %>
<div class="user-roles-layout">
  <nav class="user-roles-sections" aria-label="Role management sections">
    <a class="button" href="#add-user-role">Add Role to User</a>
    <a class="button" href="#users-with-roles">Users with Roles</a>
    <a class="button" href="#all-additional-roles">All Additional Roles Summary</a>
    <a class="button" href="#roles-help">How It Works</a>
  </nav>

  <aside class="panel user-role-directory" aria-label="KAMAR user directory">
    <% for (const [type, label, hint] of [['staff', 'Staff', 'name, email or staff code'], ['student', 'Student', 'name, email or student ID']]) { %>
      <section>
        <h2><%= label %> List</h2>
        <p>Select a <%= type %> member to load their details into the role form.</p>
        <label for="role-search-<%= type %>">Search <%= type %></label>
        <input id="role-search-<%= type %>" type="search" maxlength="80" placeholder="Search <%= hint %>" autocomplete="off">
        <p id="role-search-status-<%= type %>" role="status">Type at least two characters to search.</p>
        <ul id="role-search-results-<%= type %>" class="user-role-results"></ul>
      </section>
    <% } %>
  </aside>

  <div class="user-roles-main">
    <section class="panel" id="add-user-role">
      <h2>Add Role to User — <%= moduleLabel %></h2>
      <p>Signed in as <%= currentUser.email %>. Select someone from either list or enter their current KAMAR email.</p>
      <form action="/admin/users/add" method="post" class="user-role-add">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input type="hidden" name="module" value="<%= module %>">
        <div>
          <label for="role-user-type">User type</label>
          <select id="role-user-type" name="type" required>
            <option value="">Select type</option>
            <option value="staff">Staff</option>
            <option value="student">Student</option>
          </select>
        </div>
        <div>
          <label for="role-user-email">User email</label>
          <input id="role-user-email" name="email" type="email" maxlength="254" required autocomplete="off">
        </div>
        <div>
          <label for="role-to-add">Role to add</label>
          <select id="role-to-add" name="roleId" required>
            <option value="">Select role</option>
            <% roles.forEach((role) => { %><option value="<%= role.id %>"><%= role.name %></option><% }) %>
          </select>
        </div>
        <button class="button button-primary" type="submit">Add role</button>
      </form>
      <p id="role-selected-person" role="status">No directory user selected.</p>
      <% if (module !== 'global') { %>
        <ul><% roles.forEach((role) => { %><li><strong><%= role.name %>:</strong> <%= role.description %></li><% }) %></ul>
      <% } %>
    </section>

    <section class="panel" id="users-with-roles">
      <h2>Users with Additional Roles — <%= moduleLabel %></h2>
      <% if (!users.length) { %><p>No <%= moduleLabel %> roles are assigned here.</p><% } else { %>
        <div class="user-role-table-wrap">
          <table class="user-role-table">
            <thead><tr><th scope="col">Type</th><th scope="col">User</th><th scope="col">Additional roles</th><th scope="col">Actions</th></tr></thead>
            <tbody>
              <% users.forEach((user) => { %>
                <tr>
                  <td><%= user.is_staff ? 'Staff' : user.is_student ? 'Student' : 'Other' %></td>
                  <td><strong><%= user.display_name %></strong><br><%= user.email %></td>
                  <td><% user.assignments.forEach((role) => { %>
                    <div class="user-role-assignment"><span class="access-source"><%= role.name %></span>
                      <% if (role.source !== 'manual') { %><small><%= role.source %>-managed</small><% } %>
                    </div>
                  <% }) %></td>
                  <td><% user.assignments.forEach((role) => { %>
                    <% if (role.source === 'manual') { %>
                      <form action="/admin/users/remove" method="post" class="user-role-remove">
                        <input type="hidden" name="csrf" value="<%= csrf %>">
                        <input type="hidden" name="module" value="<%= module %>">
                        <input type="hidden" name="userId" value="<%= user.id %>">
                        <input type="hidden" name="roleId" value="<%= role.id %>">
                        <button class="button" type="submit" aria-label="Remove <%= role.name %> from <%= user.email %>">Remove <%= role.name %></button>
                      </form>
                    <% } %>
                  <% }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <section class="panel" id="roles-help">
      <h2>How It Works</h2>
      <ul>
        <li><strong>Primary access:</strong> Staff and Student access comes from the current KAMAR lists and is refreshed at Google sign-in.</li>
        <li><strong>Module roles:</strong> Select a hub to manage its existing roles, such as Lead Teacher, Teacher or Staff where available. Lead Teacher manages that hub, not the whole system. Role choices differ by hub.</li>
        <li><strong>Global roles:</strong> Select Global Control to add ADMIN, Teacher or Lead Teacher. Global Lead Teacher has the same access as Teacher; it does not grant ADMIN or hub administration. Assigning a role before a person's first sign-in prepares their account; it does not sign them in.</li>
        <li><strong>Combined access:</strong> Permissions from assigned roles work together. ADMIN grants system-wide administration, not just DTECH-HUB access. Hub role changes do not change global roles, other hubs or area-specific grants.</li>
        <li><strong>Protected roles:</strong> KAMAR and system-managed assignments cannot be removed here. Only manually assigned additional roles have Remove buttons.</li>
        <li><strong>Directory:</strong> Searches use current uploaded KAMAR staff and students. Missing people or email addresses must be corrected in KAMAR Uploader.</li>
      </ul>
    </section>
  </div>
</div>
<% } %>
<section class="panel" id="all-additional-roles">
  <h2>All Additional Roles Summary</h2>
  <p>Read-only overview across all modules, regardless of the module selected above. KAMAR primary Staff/Student roles are not additional roles.
    Only explicitly assigned roles are listed; Global ADMIN access across hubs and inherited Teacher access are not repeated as module roles.</p>
  <p>Teacher module assignments are listed separately: these are dashboard/module allocations, not hub roles. Area-specific roles show their area key.
    Inactive accounts retain their recorded assignments but are marked inactive.</p>
  <% if (!summaryUsers.length) { %>
    <p>No additional roles or teacher module assignments are recorded.</p>
  <% } else { %>
    <div class="user-role-table-wrap">
      <table class="user-role-table">
        <caption>All users with additional roles or teacher module assignments</caption>
        <thead><tr><th scope="col">Type</th><th scope="col">User</th><th scope="col">Global Control roles</th><th scope="col">Module roles</th><th scope="col">Teacher module assignments</th></tr></thead>
        <tbody>
          <% summaryUsers.forEach((user) => { %>
            <tr>
              <td><%= user.is_staff ? 'Staff' : user.is_student ? 'Student' : 'Other' %></td>
              <td><strong><%= user.display_name %></strong><br><%= user.email %><% if (!user.is_active) { %><br><strong>Inactive account</strong><% } %></td>
              <td>
                <% if (!user.globalRoles.length) { %>None assigned<% } %>
                <% user.globalRoles.forEach((role) => { %>
                  <div class="user-role-assignment"><%= role.name %><% if (role.source !== 'manual') { %> (<%= role.source %>-managed)<% } %></div>
                <% }) %>
              </td>
              <td>
                <% if (!user.moduleRoles.length) { %>None assigned<% } %>
                <% user.moduleRoles.forEach((role) => { %>
                  <div class="user-role-assignment"><strong><%= role.module %>:</strong> <%= role.role %><% if (role.area !== null) { %> (area: <%= role.area %>)<% } %></div>
                <% }) %>
              </td>
              <td>
                <% if (!user.teacherModules.length) { %>None assigned<% } %>
                <% user.teacherModules.forEach((label) => { %><div class="user-role-assignment"><%= label %></div><% }) %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<script src="/admin-user-roles.js" defer></script>
<%- include('../partials/footer') %>
