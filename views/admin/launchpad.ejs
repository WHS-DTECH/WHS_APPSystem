<%- include('../partials/header') %>
<section class="page-title">
  <p class="eyebrow">Administration</p>
  <h1>Launchpad Management</h1>
  <p>Manage Launchpad cards for registered apps. Users must sign in and have an app assignment; Global ADMIN can open all active modules.</p>
</section>
<section class="panel">
  <% if (saved) { %><p role="status">Launchpad link saved. The hosted Launchpad is updated.</p><% } %>
  <p><a class="button" href="/">View Launchpad</a> <a class="button" href="/admin/modules">App Module Management</a> <a class="button" href="/hubs">Assign User Roles</a></p>
  <p>App destinations and active status come from App Module Management. Use local paths for integrated apps and HTTPS addresses for apps awaiting migration. Hiding a card does not revoke app access; remove the user's assignment or deactivate the module instead.</p>
  <p>Lower order numbers appear first. Clear <strong>Show on Launchpad</strong> to hide a card without deleting it. Standalone HTML downloads are retired because access requires live Google sign-in and assignments.</p>
</section>
<% const forms = [{ id: '', title: '', module_key: '', description: '', icon: 'hub', sort_order: 100, is_visible: true }, ...links]; %>
<% forms.forEach(link => { %>
<section class="panel">
  <h2><%= link.id ? link.title : 'Add a module or service' %><% if (link.id && !link.is_visible) { %> (hidden)<% } %></h2>
  <form class="row-form stacked" action="/admin/launchpad/save" method="post">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <input type="hidden" name="id" value="<%= link.id %>">
    <label>Module name <input name="title" value="<%= link.title %>" maxlength="100" required></label>
    <label>Registered app <select name="moduleKey" required><option value="">Choose a module</option><% modules.forEach(module => { %><option value="<%= module.module_key %>" <%= module.module_key === link.module_key ? 'selected' : '' %>><%= module.display_name %><%= module.is_active ? '' : ' (inactive)' %></option><% }) %></select></label>
    <label>Description <textarea name="description" maxlength="500" rows="3" required><%= link.description %></textarea></label>
    <label>Icon <select name="icon"><% Object.entries(iconLabels).forEach(([key,label]) => { %><option value="<%= key %>" <%= key === link.icon ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
    <label>Display order <input name="sortOrder" type="number" min="0" max="9999" step="1" value="<%= link.sort_order %>" required></label>
    <label><input name="visible" type="checkbox" <%= link.is_visible ? 'checked' : '' %>> Show on Launchpad</label>
    <button class="button button-primary" type="submit"><%= link.id ? 'Save changes' : 'Add to Launchpad' %></button>
  </form>
</section>
<% }) %>
<%- include('../partials/footer') %>
