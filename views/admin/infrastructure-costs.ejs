<%- include('../partials/header') %>
<div class="cost-dashboard">
  <header class="cost-header">
    <div>
      <p class="eyebrow"><a href="/admin">Core Administration</a> / Cost reporting</p>
      <h1>GitHub &amp; Render Costs</h1>
      <p>Render planning estimates and GitHub inventory for resources visible to the configured reporting accounts, including apps outside Module Builder.</p>
    </div>
    <form action="/admin/infrastructure-costs/refresh" method="post">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="button button-primary" type="submit">Refresh costs &amp; exchange rate</button>
    </form>
  </header>

  <section class="cost-overview" aria-labelledby="estimate-heading">
    <div class="cost-section-heading">
      <div>
        <p class="cost-kicker">Monthly overview</p>
        <h2 id="estimate-heading">Planning estimate</h2>
        <p>Full-month Render compute costs at observed plans and instance counts. GitHub development costs are not included.</p>
      </div>
      <span class="cost-badge cost-badge-warning">Partial estimate</span>
    </div>
    <div class="cost-metrics">
      <article class="cost-metric cost-metric-primary">
        <h3>Render known estimate</h3>
        <strong><%= money(summary.render.usd) %></strong>
        <span><%= nzd(summary.render.usd) %> per month · <%= summary.render.known %> priced resources · <%= summary.render.unknown %> unknown</span>
      </article>
      <article class="cost-metric cost-metric-attention">
        <h3>Unknown Render costs</h3>
        <strong><%= summary.render.unknown %></strong>
        <span>resource compute costs not priced</span>
      </article>
      <a class="cost-metric cost-metric-link" href="#<%= snapshot.render?.data ? 'render-workspaces' : 'render-costs' %>">
        <h3>Render workspace base rate</h3>
        <strong><%= money(summary.workspaceSubscriptions.usd) %></strong>
        <span>Recorded monthly rate<% if (Number.isFinite(summary.workspaceSubscriptions.usd)) { %> · <%= nzd(summary.workspaceSubscriptions.usd) %><% } %><% if (summary.workspaceSubscriptions.unknown) { %> · <%= summary.workspaceSubscriptions.unknown %> unpriced<% } %><br>View workspace details →</span>
      </a>
    </div>
    <div class="cost-notice">
      <strong>Not the total bill or an invoice.</strong>
      Unknown costs are not treated as free. The estimates can include stale data and exclude storage, usage extras,
      discounts, tax, proration and currency conversion fees. Provider billing is authoritative.
    </div>
    <% const incompleteProviders = ['render', 'github'].filter(key => !snapshot[key] || snapshot[key].error); %>
    <% if (incompleteProviders.length) { %>
      <p class="cost-alert" role="status"><strong>Inventory needs attention:</strong>
        <%= incompleteProviders.map(key => `${key === 'render' ? 'Render' : 'GitHub'}: ${!snapshot[key] ? 'not checked' : snapshot[key].data ? 'stale data' : 'unavailable'}`).join(' · ') %>.
        Counts include only returned resources and accounts.</p>
    <% } %>
    <% if (snapshot.exchange?.error) { %><p class="cost-alert" role="alert"><strong>Exchange rate refresh failed:</strong> <%= snapshot.exchange.error %></p><% } %>
    <% if (rate) { %>
      <p class="cost-rate">USD 1 = NZD <%= rate.toFixed(4) %> · rate dated <%= new Date(snapshot.exchange.data.updatedAt).toLocaleString('en-NZ') %> ·
        <a href="<%= sources.exchange %>" target="_blank" rel="noopener noreferrer">ExchangeRate-API</a></p>
    <% } else { %><p class="cost-rate" role="status">NZD conversion unavailable. Refresh to obtain a valid rate; USD estimates are still shown.</p><% } %>
    <details class="cost-explanation">
      <summary>About these estimates and refresh</summary>
      <p>Published Render USD price catalogue checked <%= priceChecked %>:
        <a href="<%= sources.render %>" target="_blank" rel="noopener noreferrer">Render pricing</a>. Prices may change.</p>
      <p>Refresh makes read-only provider requests. It does not create, upgrade, delete or reconnect resources.
        No credentials, connection strings or environment-variable values are saved in this report.</p>
    </details>
  </section>

  <nav class="cost-jump" aria-label="Cost report sections">
    <span>Jump to</span>
    <a href="#render-costs">Render</a>
    <a href="#github-costs">GitHub</a>
    <a href="#development-policy">New app policy</a>
  </nav>

  <% for (const [key, title] of [['render', 'Render'], ['github', 'GitHub']]) { const section = snapshot[key]; %>
  <section class="cost-provider" id="<%= key %>-costs" aria-labelledby="<%= key %>-heading">
    <div class="cost-section-heading">
      <div>
        <p class="cost-kicker">Provider breakdown</p>
        <h2 id="<%= key %>-heading"><%= title %></h2>
        <% if (section?.data) { %><p>Last successful check: <%= new Date(section.data.checkedAt).toLocaleString('en-NZ') %></p><% } %>
      </div>
      <span class="cost-badge <%= section?.error ? 'cost-badge-warning' : '' %>"><%= !section ? 'Not checked' : section.error ? (section.data ? 'Stale data' : 'Unavailable') : 'Last check succeeded' %></span>
    </div>
    <% if (!section) { %><p>Not checked yet. Use Refresh above to load the provider inventory.</p><% } %>
    <% if (section?.error) { %>
      <div class="cost-alert" role="alert">
        <strong>Refresh failed<%= section.data ? ' — showing stale data' : ' — no inventory available' %>:</strong> <%= section.error %><br>
        Last attempted: <%= new Date(section.attemptedAt).toLocaleString('en-NZ') %>
      </div>
    <% } %>
    <% if (section?.data) { const data = section.data; %>
      <% if (key === 'render') { %>
        <p class="cost-provider-warning"><%= data.warning %></p>
        <section id="render-workspaces" aria-labelledby="render-workspaces-heading">
          <h3 id="render-workspaces-heading">Render workspace details</h3>
          <p>Workspace base rates are recorded manually from Render billing and are not included in the resource compute estimate. Check them when plans change.</p>
          <% if (!data.workspaces.length) { %><p>No workspaces were returned for this key.</p><% } %>
          <% data.workspaces.forEach(workspace => {
            const resources = data.resources.filter(resource => resource.owner === workspace.id);
            const subtotal = summarizeCosts(resources);
            const subscription = snapshot.workspaceSubscriptions?.[workspace.id];
            const recorded = Number.isFinite(subscription?.monthlyUsd);
          %>
            <div class="cost-workspace">
              <h4><%= workspace.name %></h4>
              <p><code><%= workspace.id %></code><br>
                <%= resources.length %> returned resources: <%= resources.filter(resource => resource.type === 'web_service').length %> web services,
                <%= resources.filter(resource => resource.type === 'postgres').length %> PostgreSQL databases,
                <%= resources.filter(resource => !['web_service', 'postgres'].includes(resource.type)).length %> other services.</p>
              <p>Workspace base rate: <strong><%= recorded ? money(subscription.monthlyUsd) : 'Unknown' %></strong><% if (recorded) { %> per month · manually recorded <%= new Date(subscription.recordedAt).toLocaleDateString('en-NZ') %><% } %>.<br>
                Known resource compute: <strong><%= money(subtotal.usd) %></strong> / <%= nzd(subtotal.usd) %> per month;
                <%= subtotal.unknown %> resource costs unknown.</p>
              <form class="cost-workspace-rate" action="/admin/infrastructure-costs/workspace-subscription" method="post">
                <input type="hidden" name="csrf" value="<%= csrf %>">
                <input type="hidden" name="workspaceId" value="<%= workspace.id %>">
                <label>Monthly workspace base rate (USD)
                  <input type="number" name="monthlyUsd" min="0" max="9999999.99" step="0.01" value="<%= recorded ? subscription.monthlyUsd.toFixed(2) : '' %>" aria-label="Monthly workspace base rate (USD) for <%= workspace.name %>">
                </label>
                <button class="button" type="submit">Save rate</button>
                <span>Leave blank to clear. Confirm against Render billing.</span>
              </form>
              <% if (resources.length) { %>
              <details class="cost-explanation">
                <summary>View resources in <%= workspace.name %></summary>
                <ul><% resources.forEach(resource => { %>
                  <li><strong><%= resource.name %></strong> — <%= resource.type %>; <%= money(resource.monthlyUsd) %> per month</li>
                <% }) %></ul>
              </details>
              <% } %>
            </div>
          <% }) %>
        </section>
        <% if (!data.resources.length) { %><p>No services or PostgreSQL databases were returned for this key.</p><% } %>
        <% const renderGroups = [
          ['Web Services', data.resources.filter(resource => resource.type === 'web_service')],
          ['PostgreSQL databases', data.resources.filter(resource => resource.type === 'postgres')],
          ['Other services', data.resources.filter(resource => !['web_service', 'postgres'].includes(resource.type))]
        ]; %>
        <% renderGroups.forEach(([heading, resources]) => { if (!resources.length) return;
          const subtotal = summarizeCosts(resources);
        %>
        <div class="cost-category-heading">
          <h3><%= heading %> (<%= resources.length %>)</h3>
          <p>Known compute subtotal: <strong><%= money(subtotal.usd) %></strong> / <%= nzd(subtotal.usd) %> per month<% if (subtotal.unknown) { %> · <%= subtotal.unknown %> unpriced<% } %></p>
        </div>
        <div class="user-role-table-wrap cost-table-wrap" role="region" aria-label="Render <%= heading %> cost table" tabindex="0">
          <table>
            <caption><%= heading %> — full-month compute estimates (USD and indicative NZD)</caption>
            <thead><tr><th scope="col">Resource / workspace</th><th scope="col">Type / region</th><th scope="col">Plan / status</th><th scope="col">Monthly USD</th><th scope="col">Indicative NZD</th><th scope="col">Coverage</th></tr></thead>
            <tbody>
            <% resources.forEach(resource => { %>
              <tr><td><strong><%= resource.name %></strong><br><code><%= resource.id %></code><br><%= data.workspaces.find(w => w.id === resource.owner)?.name || resource.owner %></td>
                <td><%= resource.type %><br><%= resource.region %></td>
                <td><%= resource.plan %><br><%= resource.status %><% if (resource.instances !== null) { %><br><%= resource.instances %> instance(s)<% } %></td>
                <td class="cost-amount"><%= money(resource.monthlyUsd) %></td><td class="cost-amount"><%= nzd(resource.monthlyUsd) %></td>
                <td><%= resource.note %><% if (resource.storageGb !== null) { %><br>Provisioned DB storage: <%= resource.storageGb %> GB (cost excluded).<% } %></td></tr>
            <% }) %>
            </tbody>
          </table>
        </div>
        <% }) %>
        <a class="button" href="https://dashboard.render.com" target="_blank" rel="noopener noreferrer">Open Render for actual invoices</a>
      <% } else { %>
        <p class="cost-provider-warning">Only accounts and repositories visible to this token are reported.
          GitHub development costs are not shown in this report. Repository access does not establish billing access.</p>
        <form action="/admin/infrastructure-costs/student-accounts" method="post">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <p>Mark student accounts to group them below. This is a local category, not verification of a free plan; unknown costs stay unknown.</p>
        <% const githubGroups = [
          ['Student Accounts - Free Subscriptions', data.accounts.filter(account => studentAccounts.has(account.login.toLowerCase()))],
          ['Other accounts', data.accounts.filter(account => !studentAccounts.has(account.login.toLowerCase()))]
        ]; %>
        <% githubGroups.forEach(([heading, accounts]) => { %>
        <h3><%= heading %> (<%= accounts.length %>)</h3>
        <% if (!accounts.length) { %><p>No accounts in this category.</p><% } else { %>
        <div class="user-role-table-wrap cost-table-wrap cost-account-table" role="region" aria-label="GitHub <%= heading %> account table" tabindex="0">
          <table>
            <caption>GitHub accounts and visible repositories</caption>
            <thead><tr><th scope="col">Student account</th><th scope="col">Account</th><th scope="col">Plan / seats</th><th scope="col">Visible repositories</th></tr></thead>
            <tbody>
            <% accounts.forEach(account => { %>
              <tr><td><input type="checkbox" name="studentAccounts" value="<%= account.login %>" aria-label="Student account: <%= account.login %>" <%= studentAccounts.has(account.login.toLowerCase()) ? 'checked' : '' %>></td>
                <td><strong><%= account.login %></strong><br><%= account.type %></td><td><%= account.plan %><br>Seats: <%= account.seats === null ? 'Unknown' : account.seats %></td>
                <td><%= account.repositoryCount %></td></tr>
            <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
        <% }) %>
        <button class="button" type="submit">Save student account categories</button>
        </form>
        <details class="cost-explanation"><summary>Visible repository inventory (<%= data.repositories.length %>)</summary>
          <ul><% data.repositories.forEach(repository => { %><li><%= repository.name %> — <%= repository.private ? 'Private' : 'Public' %></li><% }) %></ul>
        </details>
      <% } %>
    <% } %>
  </section>
  <% } %>
  <section class="cost-policy" id="development-policy" aria-labelledby="development-heading">
    <div>
      <p class="cost-kicker">Planning ahead</p>
      <h2 id="development-heading">New development app policy</h2>
      <p>Each newly provisioned app must be a Render Web Service with its own connected PostgreSQL database,
        both in Oregon. The lowest paid compute tiers are 0.5c-512mb and 0.1c-256mb:
        <strong>USD 13/month compute-only per app</strong>, plus database storage and any account/workspace or usage charges.</p>
    </div>
    <a class="button" href="/module-builder">Open Module Builder</a>
  </section>
</div>
<%- include('../partials/footer') %>
