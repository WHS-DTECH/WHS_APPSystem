<%- include('../partials/header') %>
<style>
  .sa-btn{margin:4px 8px 4px 0;display:inline-flex;align-items:center;justify-content:center;min-height:0;height:auto;padding:9px 22px;border-radius:999px;border:2px solid #0b5d4b;background:#0b5d4b;color:#fff!important;font:600 15px/1.2 inherit;font-family:inherit;text-decoration:none;cursor:pointer;box-shadow:0 2px 4px rgba(0,0,0,.18);transition:background .15s,transform .05s}
  .sa-btn:hover{background:#08463a;border-color:#08463a}
  .sa-btn:active{transform:translateY(1px)}
  .sa-btn.sa-alt{background:#fff;color:#0b5d4b!important}
  .sa-btn.sa-alt:hover{background:#e6f2ee}
  .sa-btn.sa-warn{background:#a85d0a;border-color:#a85d0a}
  .sa-btn.sa-warn:hover{background:#8a4c08}
</style>
<%
  const loginDone = Boolean(app.login_verified_at);
  const rolesDone = Boolean(app.roles_mapped_at);
  const tick = (done) => done ? '<span style="color:#1d6b3c">&#10003;</span>' : '<span style="color:#b9770e">&#9679;</span>';
%>

<section class="page-title">
  <p class="eyebrow">Student Apps</p>
  <h1><%= app.name %></h1>
  <p><%= app.app_url || "Web address assigned when registered" %></p>
</section>

<% if (app.status !== 'active') { %>
<section class="panel">
  <h2><%- tick(false) %> Waiting to be registered</h2>
  <% if (submitted) { %><p style="background:#e3f4e8;color:#1d6b3c;padding:10px 12px;border-radius:8px">Thanks! Your project details have been sent. You will get an email when it is registered.</p><% } %>
  <% if (siteAdmin) { %>
    <p>The WHS_APP_SECRET was emailed to you when the project was submitted. Add it to the project's Render service, then confirm below. The student is emailed to log in and continue.</p>
    <form method="post" action="/student-apps/<%= app.slug %>/activate">
      <button class="sa-btn" type="submit">Secret loaded - project is registered</button>
    </form>
    <form method="post" action="/student-apps/<%= app.slug %>/secret" onsubmit="return confirm('Make a new secret? The old one stops working.')">
      <button class="sa-btn sa-alt" type="submit">Make a new secret (shown here once)</button>
    </form>
    <% if (secret) { %>
      <div style="background:#fff8e6;border:1px solid #e8c36a;border-radius:8px;padding:12px;margin-top:12px">
        <strong>New secret &mdash; shown once.</strong>
        <p><code style="user-select:all"><%= secret %></code></p>
      </div>
    <% } %>
  <% } else { %>
    <p>An administrator is setting up your project's connection. You will get an email when it is registered, then log in here to continue.</p>
  <% } %>
</section>
<% } else { %>
<% if (activated) { %><section class="panel"><p style="background:#e3f4e8;color:#1d6b3c;padding:10px 12px;border-radius:8px">Project registered. The student has been emailed.</p></section><% } %>
<section class="panel">
  <h2><%- tick(true) %> Step 1 &mdash; Registered</h2>
  <p>Your project is registered. It keeps its own database and web service.</p>
</section>

<section class="panel">
  <h2><%- tick(loginDone) %> Step 2 &mdash; Google sign-in</h2>
  <% if (secret) { %>
    <div style="background:#fff8e6;border:1px solid #e8c36a;border-radius:8px;padding:12px;margin-bottom:12px">
      <strong>New app secret &mdash; shown once.</strong>
      <p><code style="font-size:1.05em;user-select:all"><%= secret %></code></p>
      <p>Add it to the app's Render service as <code>WHS_APP_SECRET</code>. Never put it in GitHub.</p>
    </div>
  <% } %>
  <ol>
    <li>Your teacher has already loaded the app secret, so you do not need Render access.</li>
    <li>Add this route to your app. It receives the person who just signed in with Google:
      <pre style="background:#f3f7fc;padding:12px;border-radius:8px;overflow:auto"><code><%= snippet %></code></pre>
    </li>
    <li>Click <strong>Test sign-in</strong>. You sign in with your school Google account, are sent to your app, and your app asks the school system who you are.</li>
  </ol>
  <p>
    <% if (app.app_url) { %><a class="sa-btn" href="<%= launchUrl %>">Test sign-in</a><% } else { %><span style="color:#b9770e">Your web address is assigned when the project is registered.</span><% } %>
    <% if (loginDone) { %> Verified <%= new Date(app.login_verified_at).toLocaleString('en-NZ') %><% } else { %> Not tested yet<% } %>
  </p>
  <% if (siteAdmin) { %><form method="post" action="/student-apps/<%= app.slug %>/secret" onsubmit="return confirm('Make a new secret? The old one stops working.')">
    <button class="sa-btn sa-alt" type="submit">Make a new secret</button>
  </form><% } %>
</section>

<section class="panel">
  <h2><%- tick(rolesDone) %> Step 3 &mdash; Map roles</h2>
  <% if (!loginDone) { %>
    <p style="color:#6a84a1">Finish step 2 first. Roles are mapped once sign-in works.</p>
  <% } else { %>
    <% if (saved) { %><p style="background:#e3f4e8;color:#1d6b3c;padding:10px 12px;border-radius:8px">Roles saved.</p><% } %>
    <p>When someone signs in, their school role becomes one of your app's roles. Leave a row empty to give that school role no access. Type your app's own role name (for example Counsellor) or pick one from the list.</p>
    <form method="post" action="/student-apps/<%= app.slug %>/roles" class="module-form">
      <table>
        <thead><tr><th>School role</th><th>Becomes this role in your app</th></tr></thead>
        <tbody>
          <% platformRoles.forEach(function (role) { %>
            <tr>
              <td><%= role.label %></td>
              <td>
                <input name="map_<%= role.key %>" list="roles-<%= app.id %>" value="<%= mapping[role.key] || '' %>" placeholder="Role name in your app">
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <datalist id="roles-<%= app.id %>"><% app.app_roles.forEach(function (r) { %><option value="<%= r %>"><% }) %></datalist>
      <button class="sa-btn" type="submit">Save roles</button>
    </form>
  <% } %>
</section>

<section class="panel">
  <h2>Who can use it</h2>
  <p>The app's Lead Teacher gives staff and students a role in the app. Only people with a role can sign in.
    <%= assignedCount %> role assignment(s) so far.</p>
  <p><a class="sa-btn sa-alt" href="<%= rolesUrl %>">Assign user roles</a>
     <% if (loginDone && rolesDone) { %><a class="sa-btn" href="/student-apps/<%= app.slug %>/launch">Open the app</a><% } %></p>
</section>

<% } %>

<%- include('../partials/footer') %>
