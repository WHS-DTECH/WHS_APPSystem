<%- include('../partials/header') %>
<style>
  .sa-btn{margin:4px 8px 4px 0;display:inline-flex;align-items:center;justify-content:center;min-height:0;height:auto;padding:9px 22px;border-radius:999px;border:2px solid #0b5d4b;background:#0b5d4b;color:#fff!important;font:600 15px/1.2 inherit;font-family:inherit;text-decoration:none;cursor:pointer;box-shadow:0 2px 4px rgba(0,0,0,.18);transition:background .15s,transform .05s}
  .sa-btn:hover{background:#08463a;border-color:#08463a}
  .sa-btn:active{transform:translateY(1px)}
  .sa-btn.sa-alt{background:#fff;color:#0b5d4b!important}
  .sa-btn.sa-alt:hover{background:#e6f2ee}
  .sa-btn.sa-warn{background:#a85d0a;border-color:#a85d0a}
  .sa-btn.sa-warn:hover{background:#8a4c08}
</style>

<section class="page-title">
  <p class="eyebrow">Student Apps &middot; Step 1 of 3</p>
  <h1>Register your project</h1>
  <p>Tell the school system about your app. You'll then connect Google sign-in (step 2) and choose how roles work (step 3).</p>
</section>

<section class="panel">
  <% if (error) { %><p style="background:#fdeeee;color:#b42318;padding:10px 12px;border-radius:8px"><%= error %></p><% } %>
  <form method="post" action="/student-apps/new" class="module-form">
    <label>Project name
      <input name="name" value="<%= form.name || '' %>" required maxlength="80" placeholder="e.g. Guidance Counsellor App">
    </label>
    <label>What does it do?
      <textarea name="description" rows="8" maxlength="600" style="width:100%;min-height:180px"><%= form.description || '' %></textarea>
    </label>
    <label>Web address of your app
      <input name="app_url" value="<%= form.app_url || '' %>" placeholder="https://your-app.onrender.com (optional - add later)">
    </label>
    <label>Who is your client?
      <select name="client_id" required>
        <% clients.forEach(function (c, i) { %>
          <option value="<%= c.email %>" <%= (form.client_id ? form.client_id === c.email : i === 0) ? 'selected' : '' %>><%= c.display_name %><%= c.is_admin ? ' (Admin)' : '' %></option>
        <% }) %>
      </select>
    </label>
    <fieldset style="border:0;padding:0;margin:0">
      <legend>Who will use your app?</legend>
      <% roleChoices.forEach(function (r) { %>
        <label style="display:block;font-weight:normal">
          <input type="checkbox" name="roles" value="<%= r.key %>" <%= (form.roles || []).includes(r.key) ? 'checked' : '' %>> <%= r.label %>
        </label>
      <% }) %>
    </fieldset>
    <button class="sa-btn" type="submit">Register project</button>
    <a class="sa-btn sa-alt" href="/student-apps">Cancel</a>
  </form>
</section>

<%- include('../partials/footer') %>
