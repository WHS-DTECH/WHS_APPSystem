<%- include('../partials/header') %>
<style>
  .sa-btn{margin:4px 8px 4px 0;display:inline-flex;align-items:center;justify-content:center;min-height:0;height:auto;padding:9px 22px;border-radius:999px;border:2px solid #0b5d4b;background:#0b5d4b;color:#fff!important;font:600 15px/1.2 inherit;font-family:inherit;text-decoration:none;cursor:pointer;box-shadow:0 2px 4px rgba(0,0,0,.18);transition:background .15s,transform .05s}
  .sa-btn:hover{background:#08463a;border-color:#08463a}
  .sa-btn:active{transform:translateY(1px)}
  .sa-btn.sa-alt{background:#fff;color:#0b5d4b!important}
  .sa-btn.sa-alt:hover{background:#e6f2ee}
  .sa-btn.sa-warn{background:#a85d0a;border-color:#a85d0a}
  .sa-btn.sa-warn:hover{background:#8a4c08}
</style>

<section class="page-title">
  <p class="eyebrow">Student Apps</p>
  <h1>Student Apps</h1>
  <p>Apps built by students that sign in through the school's Google login. Each keeps its own database.</p>
</section>

<section class="panel">
  <p><a class="sa-btn" href="/student-apps/new">Register a project</a></p>
  <% if (canImportGithub) { %><p><a class="sa-btn sa-alt" href="/student-apps/github-import">GitHub Import / Archive</a></p><% } %>
  <% if (!apps.length) { %>
    <p>No projects registered yet.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Project</th><th>Address</th><th>Sign-in</th><th>Roles</th><th></th></tr></thead>
      <tbody>
        <% apps.forEach(function (app) { %>
          <tr>
            <td><strong><%= app.name %></strong></td>
            <td><%= app.app_url %></td>
            <td><%= app.status !== 'active' ? 'Awaiting registration' : app.login_verified_at ? 'Verified' : 'Not tested' %></td>
            <td><%= app.roles_mapped_at ? 'Mapped' : 'Not mapped' %></td>
            <td><a class="sa-btn sa-alt" href="/student-apps/<%= app.slug %>">Set up</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('../partials/footer') %>
