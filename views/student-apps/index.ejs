<%- include('../partials/header') %>
<link rel="stylesheet" href="/student-apps-dashboard.css">
<div class="apps-dashboard">
  <header class="apps-hero">
    <div>
      <p class="apps-eyebrow">Student Apps</p>
      <h1>APPs Dashboard</h1>
      <p>Discover student-built apps, open your projects, and manage their setup in one place.</p>
    </div>
    <div class="apps-actions">
      <a class="apps-button" href="/student-apps/new">Register a project</a>
      <% if (canImportGithub) { %>
        <a class="apps-button apps-secondary" href="/student-apps/github-import">GitHub Import / Archive</a>
      <% } %>
    </div>
  </header>

  <section class="apps-stats" aria-label="Project overview">
    <article><strong><%= apps.length %></strong><span>Visible projects</span></article>
    <article><strong><%= apps.filter(app => app.status === 'active').length %></strong><span>Active apps</span></article>
    <article><strong><%= apps.filter(app => app.status !== 'active').length %></strong><span>Awaiting registration</span></article>
  </section>

  <section aria-labelledby="apps-heading">
    <div class="apps-toolbar">
      <div><h2 id="apps-heading">Your apps</h2><p>Open an app or view its setup details.</p></div>
      <div class="apps-view-switch" role="group" aria-label="App display" hidden>
        <button type="button" data-apps-view="grid" aria-pressed="true" aria-controls="apps-collection">Grid</button>
        <button type="button" data-apps-view="list" aria-pressed="false" aria-controls="apps-collection">List</button>
      </div>
    </div>
    <% if (!apps.length) { %>
      <div class="apps-empty"><h3>No projects yet</h3><p>Register a project to get started. Only projects you have permission to see appear here.</p></div>
    <% } else { %>
      <div class="apps-collection" id="apps-collection">
        <% apps.forEach(function (app) {
          const active = app.status === 'active';
          const connected = active && (app.hosted || app.login_verified_at);
          const ready = active && connected && app.roles_mapped_at;
        %>
          <article class="apps-card">
            <div class="apps-card-banner">
              <span class="apps-monogram" aria-hidden="true"><%= app.name.trim().charAt(0).toUpperCase() %></span>
              <span class="apps-status"><%= active ? 'Active' : 'Awaiting registration' %></span>
            </div>
            <div class="apps-card-content">
              <h3><%= app.name %></h3>
              <p class="apps-description"><%= app.description || 'A student-built project connected to the school Google framework.' %></p>
              <dl class="apps-details">
                <div><dt>Hosting</dt><dd><%= app.hosted ? 'Hosted in WHS APPSystem' : 'External app' %></dd></div>
                <div><dt>Sign-in</dt><dd><%= !active ? 'Awaiting registration' : app.hosted ? 'Connected automatically' : app.login_verified_at ? 'Verified' : 'Not tested' %></dd></div>
                <div><dt>Roles</dt><dd><%= app.roles_mapped_at ? 'Mapped' : 'Setup required' %></dd></div>
              </dl>
              <div class="apps-card-actions">
                <% if (ready) { %>
                  <a class="apps-button" href="/student-apps/<%= app.slug %>/open" aria-label="Open app: <%= app.name %>">Open app</a>
                <% } else { %>
                  <span class="apps-not-ready">Complete setup to open</span>
                <% } %>
                <a class="apps-button apps-secondary" href="/student-apps/<%= app.slug %>" aria-label="Set up: <%= app.name %>">Set up</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>
<script src="/student-apps-dashboard.js"></script>
<%- include('../partials/footer') %>
