<%- include('../partials/header') %>
<link rel="stylesheet" href="/module-builder.css">
<section class="page-title">
  <p class="eyebrow">Core Administration</p>
  <h1>New Development App</h1>
  <p>A private repository, shared WHS starter, Oregon Web Service and its own connected database.</p>
</section>
<section class="panel">
  <p>Global administrators have access. Optionally select individual testers below; they receive this app's Teacher role only.
    No public, student-wide or school-wide access is granted. Existing apps and assessment data are not changed.</p>
  <form action="/module-builder/new/review" method="post" class="mb-form">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <label class="mb-wide">App name<input name="name" maxlength="100" placeholder="Workshop Equipment" required></label>
    <label class="mb-wide">Purpose<textarea name="description" rows="4" maxlength="1500" required></textarea></label>
    <fieldset class="mb-wide mb-testers" aria-describedby="tester-help">
      <legend>Optional named testers (leave empty for administrators only)</legend>
      <p id="tester-help">Search by name or school email, then tick individual people. Selections stay checked when you search.
        The full current Staff and Student Lists come from Kamar Uploader, matched to WHS_APPSystem accounts by school email.
        People without an active matching account are shown but cannot be selected until their school sign-in is available.
        Selecting a student still grants this development app's <strong>Teacher tester role</strong>, not restricted student access.</p>
      <div class="mb-grid">
        <% const groups = [
          { key: 'staff', label: 'Staff', people: testers.filter(person => person.is_staff) },
          { key: 'students', label: 'Students', people: testers.filter(person => person.is_student) },
          { key: 'other', label: 'Other accounts', people: testers.filter(person => !person.is_staff && !person.is_student) }
        ]; groups.forEach(group => { if (group.key === 'other' && !group.people.length) return; %>
        <section class="mb-tester-group" data-tester-group aria-labelledby="testers-<%= group.key %>-heading">
          <h2 id="testers-<%= group.key %>-heading"><%= group.label %></h2>
          <% if (group.key === 'other') { %><p>Not matched to either current Kamar list. Check the person's identity before selecting.</p><% } %>
          <label>Search <%= group.label.toLowerCase() %> by name or email<input type="search" data-tester-search aria-controls="testers-<%= group.key %>-list" autocomplete="off"></label>
          <p data-tester-count role="status" aria-live="polite"><%= group.people.length %> shown; 0 selected</p>
          <div class="mb-tester-list" id="testers-<%= group.key %>-list">
            <% group.people.forEach(tester => { %>
            <label class="mb-tester-option" data-tester-option>
              <input type="checkbox" name="testers" value="<%= tester.id || '' %>" <%= tester.unavailable ? 'disabled' : '' %>>
              <span><span><%= tester.display_name %></span><small><%= tester.email || 'School email not recorded' %></small>
                <% if (tester.reference) { %><small><%= group.key === 'staff' ? 'Staff code' : 'Student ID' %>: <%= tester.reference %></small><% } %>
                <% if (tester.unavailable) { %><small class="mb-tester-unavailable"><%= tester.unavailable %></small><% } %>
              </span>
            </label>
            <% }) %>
          </div>
          <p data-tester-empty <%= group.people.length ? 'hidden' : '' %>>No matching <%= group.label.toLowerCase() %>.</p>
        </section>
        <% }); %>
      </div>
    </fieldset>
    <p class="mb-wide">The next screen generates the app key and shows the minimum paid plans and access for approval.
      Reviewing does not create external resources. GitHub owner: <strong><%= configuration.githubOwner %></strong>.</p>
    <div class="mb-actions mb-wide">
      <button class="button button-primary" type="submit">Review setup and costs</button>
      <a class="button" href="/module-builder">Existing development apps</a>
    </div>
  </form>
</section>
<script src="/development-testers.js" defer></script>
<%- include('../partials/footer') %>
