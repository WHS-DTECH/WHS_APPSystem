<%- include('partials/header') %>

<section class="hero">
  <div>
    <p class="eyebrow">Westland High School</p>
    <h1>Your school apps. One starting point.</h1>
    <p class="lede">Sign in with your school Google account to open your WHS Launchpad and see your assigned apps.</p>
    <% if (!currentUser) { %>
      <% if (typeof loginFailed !== 'undefined' && loginFailed) { %>
        <p role="alert">School sign-in did not complete. Try again with your school Google account. If it still fails, email tech@westlandhigh.school.nz with the error you see.</p>
      <% } %>
      <a class="button button-primary" href="/auth/google?next=%2F">Sign in with Google</a>
      <a class="button" href="/faults/new">Report a fault</a>
    <% } else { %>
      <a class="button button-primary" href="/dashboard">Open dashboard</a>
    <% } %>
  </div>
</section>

<% if (currentUser && modules.length) { %>
  <section class="panel">
    <h2>Available modules</h2>
    <div class="grid">
      <% modules.forEach((module) => { %>
        <a class="module-card" href="<%= module.path %>">
          <strong><%= module.display_name %></strong>
          <span><%= module.description || 'School app module' %></span>
        </a>
      <% }) %>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>
