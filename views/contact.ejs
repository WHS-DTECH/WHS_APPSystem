<%- include('partials/header') %>
<link rel="stylesheet" href="/contact.css">
<section class="panel whs-contact">
  <h1>Contact Web Master</h1>
  <p>Send a message to <a href="mailto:<%= recipient %>"><%= recipient %></a> using Global Control's Google email service.</p>
  <p>Signed in as <strong><%= sender %></strong>. Replies will go to this school email address.</p>
  <% if (message) { %><p role="<%= sent ? 'status' : 'alert' %>"><%= message %></p><% } %>
  <% if (!sent) { %>
  <form action="/contact" method="post">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <label for="contact-subject">Subject</label>
    <input id="contact-subject" name="subject" maxlength="150" required value="<%= values.subject || '' %>">
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" rows="10" maxlength="10000" required><%= values.message || '' %></textarea>
    <button class="button button-primary" type="submit">Send message</button>
  </form>
  <% } else { %><p><a href="/contact">Send another message</a></p><% } %>
  <p><a href="/dashboard">Global Control dashboard</a></p>
</section>
<%- include('partials/footer') %>
