<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | WHS APPSystem</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="<%= activeRole ? 'theme-' + activeRole.toLowerCase() : 'theme-public' %>">
  <header class="site-header">
    <div class="site-header-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>WHS APPSystem</span>
      </a>
      <nav class="nav">
        <% if (currentUser) { %>
          <a href="/dashboard">Dashboard</a>
          <a href="/profile">Profile</a>
          <% if (isAdmin) { %>
            <a href="/admin">Admin</a>
          <% } %>
          <span class="role-badge"><%= activeRole %></span>
          <form action="/logout" method="post">
            <button class="link-button" type="submit">Sign out</button>
          </form>
        <% } else { %>
          <a class="button button-primary" href="/auth/google">Sign in with Google</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="page">
