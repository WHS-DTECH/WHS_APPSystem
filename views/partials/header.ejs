<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | WHS APPSystem</title>
  <link rel="stylesheet" href="/styles.css">
  <% if (typeof legacyKamarLayout !== 'undefined' && legacyKamarLayout) { %>
    <link rel="stylesheet" href="/kamar-legacy.css">
  <% } %>
</head>
<body class="<%= typeof legacyLearningSitesLayout !== 'undefined' && legacyLearningSitesLayout ? 'learning-sites-legacy-body' : (typeof legacySewingHubLayout !== 'undefined' && legacySewingHubLayout ? 'sewing-hub-legacy-body' : (typeof legacyKamarLayout !== 'undefined' && legacyKamarLayout ? 'home-body' : (activeRole ? 'theme-' + activeRole.toLowerCase() : 'theme-public'))) %>">
  <header class="site-header">
    <a class="brand" href="/">WHS APPSystem</a>
    <nav class="nav">
      <% if (currentUser) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/profile">Profile</a>
        <% if (isAdmin) { %>
          <a href="/admin">Admin</a>
        <% } %>
        <span class="role-badge"><%= activeRole %></span>
        <form action="/logout" method="post">
          <button class="link-button" type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a class="button button-primary" href="/auth/google">Sign in with Google</a>
      <% } %>
    </nav>
  </header>
  <main class="page">
