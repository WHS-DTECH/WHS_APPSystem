<%- include('../../partials/header') %>

<nav class="top-nav" aria-label="Kamar uploader navigation">
  <div class="top-nav-inner">
    <div class="top-nav-links">
      <a href="/">Home</a>
      <a href="/admin/kamar-uploader/staff">Staff Upload</a>
      <a href="/admin/kamar-uploader/staff">Student Upload</a>
      <a href="/admin/kamar-uploader/staff">Student Timetable</a>
      <a href="/admin/kamar-uploader/staff">Staff Timetable</a>
      <a href="/admin">Admin</a>
    </div>
    <div class="top-nav-user">
      <% if (currentUser) { %>
        <span class="top-nav-user-chip"><%= currentUser.display_name || currentUser.email %></span>
        <form action="/logout" method="post" style="display:inline; margin:0;">
          <button class="top-nav-signout" type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a class="top-nav-signin-link" href="/auth/google">Sign in</a>
      <% } %>
    </div>
  </div>
</nav>

<main class="home-shell">
  <section class="hero-panel">
    <div class="hero-text-wrap">
      <p class="hero-kicker">Westland High School</p>
      <h1>Kamar Uploader Dashboard</h1>
      <p class="hero-subtitle">One place to monitor Staff, Student, and Timetable uploads, with secure Google sign-in for school accounts.</p>
      <div class="hero-actions">
        <a class="hero-link" href="/admin/kamar-uploader/staff">Open Staff Upload</a>
        <a class="hero-link" href="/admin/kamar-uploader/staff">Open Student Timetable</a>
        <a class="hero-link" href="/admin/kamar-uploader/staff">Open Staff Timetable</a>
      </div>
    </div>
    <div class="hero-auth-card">
      <% if (currentUser) { %>
        <h2>Signed in</h2>
        <p>Google sign-in complete.</p>
        <div class="current-user-panel">
          <strong><%= currentUser.display_name || currentUser.email %></strong>
          <span><%= currentUser.email %></span>
          <span>Role: <%= activeRole || 'ADMIN' %></span>
          <span>Staff record: Yes</span>
          <span>Student record: No</span>
        </div>
      <% } else { %>
        <h2>Sign in</h2>
        <p>Google sign-in complete.</p>
        <a class="top-nav-signin-link" href="/auth/google">Sign in with Google</a>
      <% } %>
    </div>
  </section>

  <section class="stats-grid" aria-label="Current upload stats">
    <article class="stat-card">
      <h3>Staff</h3>
      <p class="stat-number"><%= counts.staff %></p>
      <p class="stat-meta">Total: <%= counts.staff %> | Last upload: <%= new Date(runs[0]?.started_at || Date.now()).toLocaleDateString() %></p>
    </article>
    <article class="stat-card">
      <h3>Students</h3>
      <p class="stat-number"><%= counts.students %></p>
      <p class="stat-meta">Total: <%= counts.students %> | Last upload: <%= new Date(runs[0]?.started_at || Date.now()).toLocaleDateString() %></p>
    </article>
    <article class="stat-card">
      <h3>Timetables</h3>
      <p class="stat-number"><%= counts.student_timetables + counts.staff_timetables %></p>
      <p class="stat-meta">Last upload: <%= new Date(runs[0]?.started_at || Date.now()).toLocaleDateString() %></p>
    </article>
    <article class="stat-card">
      <h3>Last Refresh</h3>
      <p class="stat-number"><%= runs[0] ? new Date(runs[0].started_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : '—' %></p>
      <p class="stat-meta">Server generated timestamp</p>
    </article>
  </section>

  <section class="dashboard-panels">
    <article class="panel">
      <h2>Upload Paths</h2>
      <ul class="panel-list">
        <li>Staff Upload for teacher/staff records.</li>
        <li>Student Upload for StudentList data and school emails.</li>
        <li>Student Timetable Upload for class timetable rows.</li>
        <li>Staff Timetable Upload for teacher timetable sheets.</li>
      </ul>
    </article>
    <article class="panel">
      <h2>Signed-in User</h2>
      <div class="current-user-panel">
        <% if (currentUser) { %>
          <strong><%= currentUser.display_name || currentUser.email %></strong>
          <span><%= currentUser.email %></span>
          <span>Role: <%= activeRole || 'ADMIN' %></span>
          <span>Staff record: Yes</span>
          <span>Student record: No</span>
        <% } else { %>
          <span>Not signed in.</span>
        <% } %>
      </div>
    </article>
  </section>

  <section class="project-links-panel" aria-label="WHS projects using Kamar data">
    <div class="project-links-header">
      <div>
        <h2>WHS Projects Using Kamar Data</h2>
        <p>Quick links to projects that depend on this uploader data.</p>
      </div>
    </div>
    <div class="project-links-list">
      <div class="project-link-card">
        <p class="project-link-card-title">No linked projects yet.</p>
      </div>
    </div>
  </section>
</main>

<%- include('../../partials/footer') %>
