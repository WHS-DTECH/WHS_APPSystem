<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Connect ChatGPT to Assessment Manager</title>
  <link rel="stylesheet" href="/account-controls.css">
</head>
<body>
  <main>
    <h1>Connect ChatGPT to Assessment Manager</h1>
    <p>Approve read-only access for eight hours to shared assessment resource information, your assessment-level summaries and authorised department audit summaries.</p>
    <p>Student-level records, marking details, free-text moderation notes and changes are excluded. Your current Assessment Manager and department permissions are checked again on each request.</p>
    <p>Information returned to ChatGPT is processed by OpenAI under your ChatGPT workspace's policies. Only approve this connection in a school-authorised workspace.</p>
    <form method="post" action="/integrations/assessment-manager/oauth/authorize">
      <% for (const [name, value] of Object.entries(fields)) { %>
        <input type="hidden" name="<%= name %>" value="<%= value %>">
      <% } %>
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button type="submit" name="decision" value="allow">Approve read-only connection</button>
      <button type="submit" name="decision" value="deny">Cancel</button>
    </form>
  </main>
</body>
</html>
