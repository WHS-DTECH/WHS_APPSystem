<%- include('../partials/header') %>
<link rel="stylesheet" href="/contact.css">
<section class="panel whs-contact">
  <h1>Report a fault</h1>
  <p>Something not working? Save a report for the WHS Helpdesk. You can track its status and replies in <a href="/faults">My fault reports</a>.</p>
  <p>Reporting as <strong><%= sender %></strong>. Do not include passwords, student records or other sensitive information.</p>
  <% if (message) { %><p role="alert"><%= message %></p><% } %>
  <form action="/faults" method="post">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <label for="fault-subject">Brief summary</label>
    <input id="fault-subject" name="subject" maxlength="150" required value="<%= values.subject || '' %>">
    <label for="fault-app">Module</label>
    <select id="fault-app" name="moduleKey" required aria-describedby="fault-app-help">
      <option value="">Choose a module</option>
      <% for (const module of modules) { %>
        <option value="<%= module.key %>" <%= values.moduleKey === module.key ? 'selected' : '' %>><%= module.name %></option>
      <% } %>
    </select>
    <p id="fault-app-help">Only modules available to your school account are listed. Choose Launchpad / school account if an app is missing or you cannot open it.</p>
    <label for="fault-url">Page (optional)</label>
    <select id="fault-url" name="pageUrl" aria-describedby="fault-url-help">
      <option value="">Not sure / whole module</option>
      <% for (const module of modules) { %>
        <optgroup label="<%= module.name %>" data-module="<%= module.key %>">
          <% for (const page of module.pages) { %>
            <option value="<%= page.url %>" <%= values.moduleKey === module.key && values.pageUrl === page.url ? 'selected' : '' %>><%= page.name %></option>
          <% } %>
        </optgroup>
      <% } %>
    </select>
    <p id="fault-url-help" role="status">Choose a module to see its main pages and sections. No URL copying is needed.</p>
    <label for="fault-description">What went wrong?</label>
    <textarea id="fault-description" name="description" rows="10" maxlength="10000" required aria-describedby="fault-description-help"><%= values.description || '' %></textarea>
    <p id="fault-description-help">Include what you clicked, what you expected, what happened instead, any error message, and roughly when it happened.</p>
    <button class="button button-primary" type="submit" <%= modules.length ? '' : 'disabled' %>>Submit fault report</button>
  </form>
  <p><a href="/launchpad">Back to Launchpad</a></p>
</section>
<script src="/fault-form.js" defer></script>
<%- include('../partials/footer') %>
