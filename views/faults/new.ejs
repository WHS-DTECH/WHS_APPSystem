<%- include('../partials/header') %>
<link rel="stylesheet" href="/contact.css">
<section class="panel whs-contact">
  <h1>Report a fault</h1>
  <p>Something not working? Save a report for the WHS Helpdesk. You can track its status and replies in <a href="/faults">My fault reports</a>.</p>
  <p>Reporting as <strong><%= sender %></strong>. Do not include passwords, student records or other sensitive information.</p>
  <% if (message) { %><p role="alert"><%= message %></p><% } %>
  <form action="/faults" method="post">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <label for="fault-subject">Brief summary</label>
    <input id="fault-subject" name="subject" maxlength="150" required value="<%= values.subject || '' %>">
    <label for="fault-app">App or service</label>
    <input id="fault-app" name="appName" maxlength="100" required placeholder="For example: Launchpad or Teacher Planner" value="<%= values.appName || '' %>">
    <label for="fault-url">Page address (optional)</label>
    <input id="fault-url" name="pageUrl" maxlength="2048" placeholder="For example: /launchpad" value="<%= values.pageUrl || '' %>" aria-describedby="fault-url-help">
    <p id="fault-url-help">Use a page path or HTTP/HTTPS address. Query strings and fragments are removed before saving.</p>
    <label for="fault-description">What went wrong?</label>
    <textarea id="fault-description" name="description" rows="10" maxlength="10000" required aria-describedby="fault-description-help"><%= values.description || '' %></textarea>
    <p id="fault-description-help">Include what you clicked, what you expected, what happened instead, any error message, and roughly when it happened.</p>
    <button class="button button-primary" type="submit">Submit fault report</button>
  </form>
  <p><a href="/launchpad">Back to Launchpad</a></p>
</section>
<%- include('../partials/footer') %>
